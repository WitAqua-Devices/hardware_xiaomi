<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.xiaomi.battery"
    android:versionCode="1"
    android:versionName="1.0"
>

    <uses-permission android:name="com.xiaomi.battery.info.READ_INFO" />

    <application
        android:label="@string/app_name"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <!--
             Shows up as a tile inside Settings > Battery rather than as a
             launcher icon. Settings picks these up from any activity that
             answers IA_SETTINGS and names a category it knows.
        -->
        <activity
            android:name=".BatteryInfoActivity"
            android:exported="true"
            android:label="@string/battery_info_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data android:name="com.android.settings.order" android:value="100" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/battery_info_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/battery_info_summary" />
        </activity>
    </application>
</manifest>
